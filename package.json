{
  "name": "mosaix-official-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4180",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 4180",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "node --test tests/registries.test.ts",
    "verify:media": "node scripts/verify-media.mjs",
    "verify": "npm run verify:media && npm run test && npm run lint && npm run build && npm run typecheck",
    "test:ai": "node --test tests/assistant.test.ts",
    "test:admin": "node --test tests/admin.test.ts",
    "setup:owner": "node scripts/setup-owner.mjs",
    "build:verified": "npm run test && npm run test:ai && npm run test:admin && npm run test:openai && npm run test:motion && npm run test:seo && npm run test:i18n && npm run test:media && npm run lint && npm run build",
    "test:openai": "node --test tests/openai.test.ts",
    "test:motion": "node --test tests/ring-geometry.test.ts",
    "test:seo": "node --test tests/seo.test.ts",
    "test:i18n": "node --test tests/i18n.test.ts",
    "optimize:media": "node scripts/optimize-media.mjs",
    "test:media": "node --test tests/media-loading.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-arabic": "5.3.0",
    "@fontsource/raleway": "5.3.0",
    "@upstash/redis": "1.39.0",
    "@vercel/blob": "2.8.1",
    "next": "16.3.8",
    "openai": "7.31.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "typescript": "6.0.2"
  }
}
